
digraph ASIS {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.48",
         label="LUMIQ BANK APP | AS-IS PROCESS (ILLUSTRATIVE)", labelloc="t",
         fontsize=20, fontname="Arial", fontcolor="#142B4A"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11,
        color="#B7C7D6", penwidth=1.4, margin="0.18,0.13", fillcolor="#F2F5F8",
        fontcolor="#24384B"];
  edge [color="#70869A", penwidth=1.6, arrowsize=0.8, fontname="Arial", fontsize=9];
  A [label="Customer submits\npayment", fillcolor="#E8F2F4", color="#168C8C"];
  B [label="Payment service\nprocesses request"];
  C [label="App status is unclear\nor delayed", fillcolor="#FFF3E5", color="#D99A42"];
  D [label="Customer checks again\nor contacts Support"];
  E [label="Support requests\ninvestigation"];
  F [label="Payments Operations\ninvestigates"];
  G [label="Customer receives\nan update"];
  H [label="Case closes", fillcolor="#E8F2F4", color="#168C8C"];
  A -> B -> C -> D -> E -> F -> G -> H;
  note [shape=note, label="Potential gaps to validate:\n• Unclear status and next step\n• No defined escalation target\n• Inconsistent proactive updates\n• Limited feedback loop",
        fillcolor="#FFF9EF", color="#D99A42", fontsize=10];
  C -> note [style=dashed, arrowhead=none, color="#D99A42"];
}
