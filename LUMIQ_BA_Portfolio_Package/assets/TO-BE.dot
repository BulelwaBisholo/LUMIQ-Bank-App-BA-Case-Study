
digraph TOBE {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.32", ranksep="0.42",
         label="LUMIQ BANK APP | TO-BE PROCESS (PROPOSED)", labelloc="t",
         fontsize=20, fontname="Arial", fontcolor="#142B4A"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10.5,
        color="#B7C7D6", penwidth=1.35, margin="0.16,0.11", fillcolor="#F2F5F8",
        fontcolor="#24384B"];
  edge [color="#70869A", penwidth=1.5, arrowsize=0.75, fontname="Arial", fontsize=9];
  A [label="Customer submits payment", fillcolor="#E8F2F4", color="#168C8C"];
  B [label="Create transaction reference"];
  C [label="Retrieve authoritative\npayment status"];
  D [label="Display Processing / Pending", fillcolor="#EAF1FA", color="#4F79A7"];
  E [shape=diamond, label="Success\nconfirmed?", fillcolor="#FFF9EF", color="#D99A42", width=1.5, height=0.8];
  F [label="Display Transaction successful\nand make proof of payment available", fillcolor="#E7F4EC", color="#4B9A69"];
  G [shape=diamond, label="Failed or\nunresolved?", fillcolor="#FFF9EF", color="#D99A42", width=1.5, height=0.8];
  H [label="Display Failed + safe next step", fillcolor="#FCEEEE", color="#C86B6B"];
  I [label="Create Payments Operations case\nwith owner and audit trail"];
  J [label="Notify customer and track progress"];
  K [label="Investigate and resolve"];
  L [label="Return / release funds where applicable"];
  M [label="Notify customer and close case", fillcolor="#E7F4EC", color="#4B9A69"];
  A -> B -> C -> D -> E;
  E -> F [label="Yes", color="#4B9A69"];
  E -> G [label="No"];
  G -> H [label="Failed", color="#C86B6B"];
  G -> I [label="Unresolved", color="#D99A42"];
  I -> J -> K -> L -> M;
  N [shape=note, label="Control principles:\n• Never show success before confirmation\n• Bounded retries + idempotency\n• Clear ownership and customer updates",
     fillcolor="#F5F0FA", color="#8A72A8", fontsize=9.5];
  I -> N [style=dashed, arrowhead=none, color="#8A72A8"];
}
